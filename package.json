{
  "name": "zoffice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A free, open-source desktop office suite with a familiar ribbon-style workflow",
  "homepage": "https://github.com/nicholaszoffice/zoffice",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicholaszoffice/zoffice.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "pnpm -F @zoffice/desktop dev",
    "build": "pnpm -F @zoffice/desktop build",
    "preview": "pnpm -F @zoffice/desktop preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,json,md,css,html,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,json,md,css,html,yml,yaml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm -F @zoffice/desktop test:e2e",
    "docx:report": "node scripts/docx-fidelity-report.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "docx": "^9.14.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
